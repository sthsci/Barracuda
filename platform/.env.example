# Local Docker Compose defaults only. Copy to .env and replace every value
# marked `change-me`. Do not reuse these credentials outside a developer laptop.

COMPOSE_PROJECT_NAME=barracuda

POSTGRES_DB=barracuda
POSTGRES_USER=barracuda
POSTGRES_PASSWORD=change-me-local-postgres

REDIS_PASSWORD=change-me-local-redis

MINIO_ROOT_USER=barracuda-local
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_BUCKET=barracuda-private
MINIO_APP_USER=barracuda-api
MINIO_APP_PASSWORD=change-me-local-minio-app

BARRACUDA_API_SECRET_KEY=change-me-local-django-secret
BARRACUDA_CAPABILITY_HMAC_KEY=change-me-local-capability-pepper
BARRACUDA_API_DEBUG=1
BARRACUDA_GUEST_RETENTION_HOURS=24
BARRACUDA_DEFAULT_SHARE_LINK_HOURS=72
BARRACUDA_MAX_SHARE_LINK_HOURS=720
BARRACUDA_MAX_DATASET_BYTES=5242880
BARRACUDA_TASK_TIME_LIMIT_SECONDS=2700
BARRACUDA_TASK_SOFT_TIME_LIMIT_SECONDS=2400

# The API uses its mock engine for front-end-only work. The compose worker
# overrides this with the installed local barracuda source package.
BARRACUDA_ANALYSIS_ENGINE=analyses.execution.MockAnalysisEngine

BARRACUDA_PUBLIC_DASH_URL=http://localhost:8501
BARRACUDA_PUBLIC_API_URL=http://localhost:8000/api/v1

# Dash remains the public application on port 8501. Django provides the
# optional account, saved-project and CSV-sharing service on port 8000.
