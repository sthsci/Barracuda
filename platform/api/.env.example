BARRACUDA_API_DEBUG=1
BARRACUDA_API_SECRET_KEY=replace-this-before-deployment
BARRACUDA_CAPABILITY_HMAC_KEY=replace-with-an-independent-random-secret
BARRACUDA_API_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///var/barracuda-api.sqlite3
BARRACUDA_DATASET_STORAGE_ROOT=var/datasets
BARRACUDA_GUEST_RETENTION_HOURS=24
BARRACUDA_DEFAULT_SHARE_LINK_HOURS=72
BARRACUDA_MAX_SHARE_LINK_HOURS=720
BARRACUDA_MAX_DATASET_BYTES=5242880
BARRACUDA_MAX_DATASET_ROWS=50000
BARRACUDA_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
BARRACUDA_CELERY_BROKER_URL=redis://localhost:6379/0
BARRACUDA_CELERY_RESULT_BACKEND=redis://localhost:6379/1
BARRACUDA_TASK_ALWAYS_EAGER=1
BARRACUDA_ANALYSIS_ENGINE=analyses.execution.MockAnalysisEngine
# For MinIO/S3-compatible storage, set:
# BARRACUDA_DATASET_STORAGE_BACKEND=storages.backends.s3.S3Storage
# BARRACUDA_DATASET_STORAGE_OPTIONS={"bucket_name":"barracuda-datasets","endpoint_url":"http://localhost:9000","access_key":"minioadmin","secret_key":"minioadmin","region_name":"us-east-1","default_acl":null,"querystring_auth":true,"file_overwrite":false}
